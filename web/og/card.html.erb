<!DOCTYPE html>
<%# Social preview card, rendered to PNG by web/og/render.rb (not served) %>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: "EB Garamond"; src: url("<%= fonts %>/eb-garamond-latin-400-normal.woff2"); font-weight: 400; }
  @font-face { font-family: "EB Garamond"; src: url("<%= fonts %>/eb-garamond-latin-400-italic.woff2"); font-weight: 400; font-style: italic; }
  @font-face { font-family: "EB Garamond"; src: url("<%= fonts %>/eb-garamond-latin-600-normal.woff2"); font-weight: 600; }
  * { box-sizing: border-box; margin: 0; }
  html, body { width: <%= width %>px; height: <%= height %>px; overflow: hidden; }
  body {
    background-color: #f3ede1;
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgb(160 132 92 / 0.09) 31px 32px);
    color: #2b241c;
    font-family: "EB Garamond", Georgia, serif;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 72px;
    align-items: center;
    padding: 0 76px;
  }
  .card { display: grid; gap: 22px; }
  .mark { width: 62px; }
  .mark g { stroke: #a3301c; stroke-width: 8; stroke-linecap: square; fill: none; }
  h1 { font-size: 88px; font-weight: 600; line-height: 0.95; letter-spacing: -0.005em; }
  .tagline { font-size: 44px; font-weight: 600; line-height: 1.15; max-width: 13em; }
  .tagline > span { display: block; text-wrap: balance; }
  .tagline em { font-style: normal; color: #a3301c; }  /* the game's red: spiral, flip */
  .tagline strong { font-weight: 600; color: #2b4a74; } /* the secret's blue: seal */
  .sub { font-size: 34px; font-style: italic; color: #62574a; line-height: 1.25; }
  .plate { background: #fbf8f2; border: 1px solid #d9cdb6; border-radius: 4px; padding: 26px;
           box-shadow: 0 1px 2px rgb(43 36 28 / 0.06), 0 22px 48px -18px rgb(43 36 28 / 0.28),
                       inset 0 0 0 6px #fbf8f2, inset 0 0 0 7px #d9cdb6; }
  .plate svg { display: block; height: <%= height - 120 - 52 %>px; width: auto; }
  .plate svg rect { fill: transparent; }
  .plate svg g { stroke: #2b241c; stroke-width: 3.2; stroke-linecap: square; }
</style>
</head>
<body>
  <div class="card">
    <svg class="mark" viewBox="-8 -8 116 166"><g><%= mark %></g></svg>
    <h1>Cistergraphia</h1>
    <p class="tagline"><span><em>Spiral it. Flip it.</em></span><span><strong>Seal it</strong> like a spy with your passphrase!</span></p>
    <p class="sub">Your secrets, in a monk’s handwriting.</p>
  </div>
  <div class="plate"><%= plate %></div>
</body>
</html>
