<div class="result-container">
  <h2>Generated Cistergraphia for: <%= @message %></h2>
  <div class="svg-container" id="svg-display">
    <%== @svg_content %>
  </div>
  <button type="button" onclick="copySvg()">Copy SVG Code</button>
  <a href="/" class="generate-link">Generate another</a>
</div>

<script>
  async function copySvg() {
    const svg = document.querySelector('#svg-display svg').outerHTML;
    try {
      await navigator.clipboard.writeText(svg);
      alert('SVG code copied to clipboard!');
    } catch (e) {
      alert('Could not copy to clipboard: ' + e.message);
    }
  }
</script>
