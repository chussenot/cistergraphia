<%#
Cistergraphia Layout: "The Abbey Index"
=======================================

Purpose:
- Shared frame of every page: masthead, the leaf (main), colophon

Design Decisions:
- Each page is a leaf of a Cistercian library index (see docs/design.md)
- Only first-party CSS, JS and fonts: a strict Content-Security-Policy applies
  (no inline script or style anywhere in the templates)
- The body carries the mode: red for the game, blue for the secret

Constraints:
- Works without JavaScript (forms post normally; JS only enhances)
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @title ? "#{@title} · " : '' %>Cistergraphia</title>
  <meta name="description" content="Write a message as Cistercian numerals coiled like a snail: a cipher game, or a passphrase-sealed secret.">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f3ede1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#191714" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
</head>
<body data-mode="<%= @secret ? 'secret' : 'game' %>">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="masthead">
    <a class="brand" href="/">
      <%== glyph_svg(1098, css: 'glyph brand-mark', title: '1098, the founding of Cîteaux') %>
      <span>
        <span class="brand-name">Cistergraphia</span>
        <span class="brand-tag">The ciphers of the monks</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/" class="<%= nav_class(:inscribe) %>"<%== ' aria-current="page"' if @page == :inscribe %>>Inscribe</a>
      <a href="/decode" class="<%= nav_class(:read) %>"<%== ' aria-current="page"' if @page == :read %>>Read</a>
    </nav>
  </header>

  <main id="main" class="folio">
    <%== yield %>
  </main>

  <footer class="colophon">
    <p>After the ciphers of the Cistercian monks, Cîteaux, 1098.</p>
    <nav aria-label="About">
      <a href="https://github.com/chussenot/cistergraphia">Source</a>
      <a href="https://github.com/chussenot/cistergraphia/blob/master/docs/security-study.md">Security study</a>
    </nav>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
