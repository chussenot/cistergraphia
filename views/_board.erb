<%#
A broken plate: the board, the tray, and the rejoining panel (app.js, initFragments).
Locals: svg, fragments (Fragments.read), size, worn (whether the plate is weathered
too: then "Restore it", enabled once the board is whole, posts the file back with
rejoined=1 and the bench opens on the plate rejoined)
%>
<figure class="plate plate--broken">
  <div class="plate-frame" id="svg-display" data-plate role="group"
       aria-label="The broken plate: an empty board, and below it the tray of fragments, some turned half round."
       data-fragments="<%= fragments_json(fragments, size) %>">
    <%== svg %>
  </div>
  <figcaption>
    <span class="plate-reading"><span class="plate-reading-rest">Lay the fragments on the board. Their edges are worn: only the sums show where each one goes.<%= ' Some signs are worn too: a join holds when every pair can balance, whatever its lacunae held. Whole again, the bench opens on it.' if worn %></span></span>
    <span class="plate-hint awaits-script" data-plate-hint>Drag a fragment onto the board, or pick it and then the cell for its top-left corner. Arrow keys move a picked fragment; T or a double click turns it. Turn and swap them until every pair balances.</span>
  </figcaption>
</figure>

<section class="rejoin awaits-script" aria-labelledby="rejoin-title" data-rejoin>
  <div class="rejoin-head">
    <h2 id="rejoin-title" class="index-heading">Rejoin it</h2>
    <div class="rejoin-tools">
      <button type="button" class="btn btn--small" data-rejoin-turn disabled>Turn half round</button>
      <button type="button" class="btn btn--small" data-rejoin-reset>Back to the tray</button>
      <% if worn %>
        <form method="post" action="/decode" class="rejoin-restore">
          <input type="hidden" name="svg" value="<%= svg %>">
          <input type="hidden" name="rejoined" value="1">
          <button type="submit" class="btn btn--small btn--primary" data-rejoin-restore disabled>Restore it</button>
        </form>
      <% end %>
    </div>
  </div>
  <p class="rejoin-status" data-rejoin-status aria-live="polite">On the board: 0 of <%= fragments_count(fragments.size) %>.</p>
  <p class="rejoin-reading" data-rejoin-reading aria-live="polite"></p>
</section>
