#!/usr/bin/env ruby
# frozen_string_literal: true

# Cistergraphia CLI Tool
# ======================
#
# Purpose:
# - Command-line interface for the Cistergraphia cipher system
# - Converts messages to SVG and optionally PNG
# - Decodes an SVG generated by Cistergraphia back into its message
# - --secret switches to secret mode (passphrase, AES-256-GCM)
# - --layout picks the reading path (phaistos, the default, rongorongo, leap,
#   furrows, unwinding or grille); decoding detects the keyless five. A grille plate needs its key
#   (--grille): writing without one draws a new grille and prints its key, and
#   --stencil writes the grille to print and cut. --decoy adds a second message
#   for a second reader: the novice's grille, drawn from the abbot's key
# - --weathered writes a game plate that has lost some strokes; decoding a
#   weathered plate restores what the pairs decide and prints the edition in
#   the Leiden conventions: [r] restored, [b/l] for the reader to settle
# - --broken writes a game plate in two to four fragments, laid in a tray
#   under an empty board; decoding a broken plate rejoins it by its sums.
#   With --weathered too, it is weathered first, and rejoined as an edition
#
# Design Decisions:
# - Uses OptionParser for command-line argument parsing
# - SVG rendering is shared with the web app (lib/cistergraphia.rb)
# - External tools are invoked without a shell, so paths are never interpreted
# - The passphrase is never a command-line argument (shell history, ps): it is
#   prompted without echo, or read from CISTERGRAPHIA_PASSPHRASE for scripts
#
# Constraints:
# - Characters missing from the cipher table are treated as separators
# - Output is always a perfect square grid
# - PNG output requires rsvg-convert (librsvg) or ImageMagick

require 'English'
require 'fileutils'
require 'io/console'
require 'optparse'
require_relative 'lib/cistergraphia'

DEFAULT_DIR = File.join(__dir__, 'tmp')

options = {}
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: cistergraphia [options]'

  opts.on('-m', '--message MESSAGE', 'The message to convert') do |m|
    options[:message] = m
  end

  opts.on('-o', '--output FILE', 'The output file path for the SVG') { |o| options[:output] = o }

  opts.on('-p', '--png FILE', 'The output file path for the PNG') { |p| options[:png] = p }

  opts.on('-d', '--decode FILE', 'Decode a Cistergraphia SVG and print its message') { |d| options[:decode] = d }

  opts.on('-l', '--layout LAYOUT', [*Cistergraphia::Layout::KEYLESS.map(&:to_s), 'grille'],
          'Reading path: phaistos (the snail, default), rongorongo, leap, furrows, unwinding or grille') do |l|
    options[:layout] = l.to_sym
  end

  opts.on('-g', '--grille KEY', "The grille's key (#{Cistergraphia::Grille::EXAMPLE}): writes or reads under it") { |g| options[:grille] = g }
  opts.on('--stencil FILE', 'Also write the grille as a stencil to print and cut') { |f| options[:stencil] = f }
  opts.on('--decoy MESSAGE', "A second message, for a novice's grille (implies a grille)") { |d| options[:decoy] = d }
  opts.on('-w', '--weathered', 'Game mode: a worn plate, some strokes lost to restore') { options[:weathered] = true }
  opts.on('-b', '--broken', 'Game mode: the plate in fragments, to rejoin (the snail only)') { options[:broken] = true }
  opts.on('--pathless', 'Game mode: the reader finds the way, the plate says nothing') { options[:pathless] = true }
  opts.on('-t', '--tally', 'Game mode: row and column sums (with -w, whole signs may be lost)') do
    options[:tally] = true
  end

  opts.on('-s', '--secret', 'Secret mode: encrypt/decrypt with a passphrase (prompted, ' \
                            'or taken from CISTERGRAPHIA_PASSPHRASE)') do
    options[:secret] = true
  end
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "#{e.message}\n#{parser.banner}"
end

def command?(name)
  ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).any? do |dir|
    File.executable?(File.join(dir, name))
  end
end

def display_svg(path)
  system('chafa', path) if command?('chafa')
end

def convert_to_png(input_path, output_path)
  converter = if command?('rsvg-convert') then ['rsvg-convert', '-o', output_path, input_path]
              elsif command?('magick') then ['magick', input_path, output_path]
              elsif command?('convert') then ['convert', input_path, output_path]
              end
  return warn('Skipping PNG: install librsvg (rsvg-convert) or ImageMagick') unless converter

  system(*converter) || warn("PNG conversion failed: #{converter.first} exited with #{$CHILD_STATUS&.exitstatus}")
end

def ask_passphrase(confirm:)
  from_env = ENV.fetch('CISTERGRAPHIA_PASSPHRASE', '')
  return from_env unless from_env.empty?

  abort 'Secret mode needs a terminal to prompt for the passphrase, or CISTERGRAPHIA_PASSPHRASE' unless $stdin.tty?

  passphrase = $stdin.getpass('Passphrase: ')
  if confirm
    problem = Cistergraphia::Secret.passphrase_problem(passphrase)
    abort problem if problem # before asking for it twice
    abort 'Passphrases do not match' if $stdin.getpass('Repeat passphrase: ') != passphrase
  end
  passphrase
end

# The layout to write or read with: a Grille when a key is given or a grille asked for
def layout_for(options, writing:)
  return Cistergraphia::Grille.new(options[:grille]) if options[:grille]
  return Cistergraphia::Grille.generate if writing && (options[:layout] == :grille || options[:decoy])

  writing ? options.fetch(:layout, :phaistos) : nil
end

if options[:decode]
  begin
    svg = File.read(options[:decode])
    passphrase = ask_passphrase(confirm: false) if options[:secret]
    grille = layout_for(options, writing: false)
    unless grille
      puts Cistergraphia.decode(svg, passphrase: passphrase)
      exit
    end
    reading = Cistergraphia::TwoReaders.read(svg, grille, passphrase: passphrase)
    puts reading.message
    puts "The novice's grille reads: #{reading.decoy}" if reading.decoy
  rescue Cistergraphia::GrilleKeyNeededError => e
    abort "#{e.message}. Add --grille KEY."
  rescue Cistergraphia::DecodeError => e
    hint = '. If this image was made in secret mode, add --secret.' unless options[:secret] || options[:grille]
    abort "#{e.message}#{hint}"
  rescue Cistergraphia::Error, SystemCallError => e
    abort e.message
  end
  exit
end

message = options[:message] || begin
  print 'What is your message? '
  $stdin.gets.to_s.chomp
end

begin
  layout = layout_for(options, writing: true)
  if options[:stencil] && !layout.is_a?(Cistergraphia::Grille)
    abort '--stencil needs a grille: add --layout grille or --grille KEY'
  end
  abort Cistergraphia::Lacunae::NOT_SEALED if options[:weathered] && options[:secret]
  abort Cistergraphia::Tally::NOT_SEALED if options[:tally] && options[:secret]
  abort Cistergraphia::Lacunae::NOT_TWO_READERS if options[:weathered] && options[:decoy]
  abort Cistergraphia::Fragments::NOT_SEALED if options[:broken] && options[:secret]
  abort Cistergraphia::Fragments::NOT_TALLIED if options[:broken] && options[:tally]
  abort Cistergraphia::Pathless::NOT_DAMAGED if options[:pathless] && (options[:weathered] || options[:broken])
  passphrase = ask_passphrase(confirm: true) if options[:secret]
  if options[:broken]
    sequence, svg, pieces, damage = Cistergraphia::Fragments.inscribe(message, layout: layout,
                                                                               weathered: options[:weathered])
    worn = ", #{damage.size} lacunae" if damage.any?
    puts "Broken: #{pieces.size} fragments#{worn}. Rejoin them on the board: every pair must balance (-d rejoins them)"
  elsif options[:weathered]
    sequence, svg, damage = Cistergraphia::Lacunae.inscribe(message, layout: layout, tally: options[:tally])
    lacunae = damage.size == 1 ? '1 lacuna' : "#{damage.size} lacunae"
    puts "Weathered: #{lacunae}. Restore them by balancing the pairs (-d shows the edition)"
  elsif options[:decoy]
    given = layout if options[:grille]
    sequence, svg, layout = Cistergraphia::TwoReaders.inscribe(message, options[:decoy], passphrase: passphrase,
                                                                                         grille: given)
  else
    sequence, svg = Cistergraphia.inscribe(message, passphrase: passphrase, layout: layout, tally: options[:tally],
                                                    pathless: options[:pathless])
    puts 'Pathless: the plate says nothing of where it begins; -d finds the way' if options[:pathless]
  end
rescue Cistergraphia::Error => e
  abort e.message
end

# The stencils to print and cut: the grille's, or the abbot's and the novice's
def write_stencils(path, size, grilles)
  FileUtils.mkdir_p(File.dirname(path))
  grilles.each_with_index do |grille, i|
    file = i.zero? ? path : path.sub(/(\.svg)?\z/, '-novice.svg')
    File.write(file, Cistergraphia::SVG.stencil(size, grille))
  end
end

if layout.is_a?(Cistergraphia::Grille)
  grilles = options[:decoy] ? [layout.as(:abbot), layout.novice] : [layout]
  if options[:decoy]
    puts "Abbot's key: #{layout} (reads both messages; keep it)"
    puts "Novice's key: #{layout.novice} (reads the decoy only)"
  else
    puts "Grille key: #{layout} (the plate cannot be read without it)"
  end
  write_stencils(options[:stencil], Integer.sqrt(sequence.size), grilles) if options[:stencil]
end

svg_path = options[:output] || File.join(DEFAULT_DIR, 'inline.svg')
png_path = options[:png] || File.join(DEFAULT_DIR, 'output.png')
[svg_path, png_path].each { |path| FileUtils.mkdir_p(File.dirname(path)) }

File.write(svg_path, svg)
display_svg(svg_path)
convert_to_png(svg_path, png_path)
